# Local development
DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/trafficguide
MODEL_DIR=/app/backend/ml/models

# Render sets PORT and RENDER_EXTERNAL_URL automatically.
# ROAD_GRAPH_MODE=demo avoids OSM downloads in constrained environments.
ROAD_GRAPH_MODE=demo

# Optional comma-separated extra CORS origins (e.g. a custom domain).
# CORS_ALLOW_ORIGINS=https://example.com

# Frontend dev server only (production build uses same origin).
# VITE_API_BASE=http://127.0.0.1:8000
